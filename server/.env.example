# Copy to .env for local development. Never commit the real .env.

# --- Storage -----------------------------------------------------------------
# Local development: a plain SQLite file, no account needed.
DATABASE_URL=file:finledger.db
# Production (Turso): libsql://<your-db>-<org>.turso.io  + the auth token.
# DATABASE_URL=libsql://finledger-yourname.turso.io
# DATABASE_AUTH_TOKEN=

# --- Auth --------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# --- Email -------------------------------------------------------------------
# Leave blank in development: mail is logged instead of sent.
# Gmail: turn on 2-step verification, then create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FinLedger <no-reply@finledger.app>

# --- Scheduling --------------------------------------------------------------
# Shared secret for POST /api/cron/monthly-reports, used by the external
# scheduler because free hosts sleep idle services.
CRON_SECRET=change-me-too

PORT=4000
